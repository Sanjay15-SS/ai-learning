                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "payment_intent"
                ]
              }
            }
          }
        }
      },
      "get": {
        "summary": "List refunds (cursor pagination)",
        "parameters": [
          {
            "name": "payment_intent",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "starting_after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "deprecated": false
      }
    },
