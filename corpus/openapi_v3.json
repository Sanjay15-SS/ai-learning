        ],
        "deprecated": false,
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "payment_method": {
                    "type": "string"
                  }
                },
                "required": []
              }
            }
          }
        }
      }
    },
    "/v3/payment_intents/{intent_id}/capture": {
      "post": {
        "summary": "Capture a manually-captured payment intent",
        "parameters": [
          {
            "name": "intent_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "deprecated": false,
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "amount_to_capture": {
                    "type": "integer"
                  }
                },
                "required": []
              }
            }
          }
        }
      }
    },
    "/v3/refunds": {
      "post": {
        "summary": "Refund a payment intent",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
